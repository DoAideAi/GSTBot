# Production environment for GSTBot. Copy to /etc/gstbot/gstbot.env on the
# server, fill in the two secrets, and lock it down:
#
#   install -d -m 0750 -o root -g gstbot /etc/gstbot
#   install -m 0640 -o root -g gstbot deploy/gstbot.env.example /etc/gstbot/gstbot.env
#
# Read by every unit in deploy/systemd/ via EnvironmentFile=. systemd parses
# this itself, so the syntax is NAME=value with no `export`, no shell
# expansion and no inline comments after a value.
#
# Every value below is what makes `validate_startup_config` log nothing at
# boot. A production deployment that warns on startup is one where somebody
# has stopped reading the warnings, so the shipped template starts at zero.

# ---- App ----
ENVIRONMENT=production
# Must be false: DEBUG returns exception detail to callers, and Settings
# refuses to start a production environment with it on.
DEBUG=false
LOG_LEVEL=INFO
# journald collects these; json is what a log shipper can parse later without
# re-deploying.
LOG_FORMAT=json
# The OpenAPI schema names every field of every tenant-scoped model. Off in
# production; run the API locally to read the docs.
DOCS_ENABLED=false

# The public origin: canonical links, the sitemap, the GPT actions' links and
# spec, the WhatsApp replies. A staging box sets its own, or it advertises
# production everywhere.
PUBLIC_SITE_URL=https://gst.doaide.com

# ---- Edge ----
# Caddy terminates TLS on the same host and rewrites X-Forwarded-For. Only
# true because of that: left true behind nothing, any caller could forge the
# header and mint itself a fresh rate-limit bucket.
TRUST_PROXY_HEADERS=true
HSTS_ENABLED=true
# The browser is served from the same origin, so this list only matters for
# a direct API call. https only — Settings rejects an http origin here.
BACKEND_CORS_ORIGINS=https://gst.doaide.com

# ---- Security ----
# REPLACE. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The value below is short on purpose: it fails the production length check,
# so a deployment that forgot this step refuses to boot instead of signing
# tokens with a value that is in a public git repository.
JWT_SECRET=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# bcrypt's cost exponent, doubling per step. Raise it on faster hardware;
# a boot below 10 is refused, so the 4 the test suite uses cannot arrive
# here by way of a promoted .env.
BCRYPT_ROUNDS=12

# ---- Database ----
# Postgres on the same host, over the loopback. REPLACE the password.
DATABASE_URL=postgresql+psycopg://gstbot:REPLACE_ME@127.0.0.1:5432/gstbot
# 2 API workers x (10 + 5) = 30, plus 2 Celery processes x 15 = 30, which is
# 60 of a stock Postgres's 100 connections — and this cluster is shared with
# Herald and HomeNex, so the budget is not ours alone. Raise max_connections
# before raising either of these or WEB_CONCURRENCY.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ---- Redis / Celery ----
# Databases 6, 7 and 8, not 0, 1 and 2. This Redis is shared: db0 is GoSumo's
# BullMQ queue, db1 is Herald's Celery broker, and db3/4/5 are CAFlow's cache,
# broker and result backend. Redis has no access control between numbered
# databases, so a collision here is not a permission error — it is Celery and
# Kombu keys interleaving with another product's, and a FLUSHDB from either
# side taking both out.
REDIS_URL=redis://127.0.0.1:6379/6
# How long a discovered Redis outage is believed before it is probed again.
# The API is ordered After=redis-server.service but does not require it, so
# starting during a Redis restart is ordinary — this is what lets that
# process pick Redis up again instead of running degraded until a restart.
REDIS_RETRY_INTERVAL_SECONDS=30
CELERY_BROKER_URL=redis://127.0.0.1:6379/7
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/8
CELERY_ENABLED=true

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
# Per-endpoint overrides, `name=count/period` separated by commas. An entry
# that will not parse is dropped with a warning rather than refusing the boot.
#
# `login_account` (10/15m) is the one to reach for during a credential
# stuffing run: it budgets *failed* sign-ins per account attempted rather than
# per address, which is the key an attacker spread over thousands of hosts
# cannot vary. A correct password refunds it immediately, so tightening it
# does not lock anyone out of their own filing.
# `advisor_daily` (100/day per address) and `advisor_site_daily` (5000/day
# for everyone together) cap what the public AI advisor can spend on Gemini.
# Raise the second as traffic grows, after checking the Gemini bill.
# RATE_LIMIT_OVERRIDES=login_account=5/15m,login=10/minute

# ---- AI (OpenRouter, free models) ----
# REPLACE. Without it every invoice falls back to heuristics and OCR, which
# still works and is materially less accurate — so the API warns at boot.
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_APP_URL=https://gst.doaide.com
OPENROUTER_APP_TITLE=DoAide GST
# Free models rate-limit as a matter of course, and a 429 the client does not
# retry is an invoice parsed by regex instead. Transient failures only (429,
# 408, 5xx, network); a 401 still fails on the first attempt.
OPENROUTER_MAX_ATTEMPTS=3
# Ceiling on total time spent waiting between those attempts, honouring the
# provider's Retry-After. Extraction runs in the worker here, so this is worker
# time rather than a user's request.
OPENROUTER_RETRY_MAX_WAIT_SECONDS=30

# ---- Uploads ----
# Under the units' StateDirectory=gstbot, which is the one path systemd
# creates and leaves writable while ProtectSystem=strict makes the rest of
# the filesystem read-only to these processes.
#
# Shared by the API and the Celery worker: the API writes the file and the
# worker reads it back by path (invoice_service.process_invoice) to parse it.
# They must see the same directory — fine on this one box, and the first thing
# to change before running a worker anywhere else: a worker without the API's
# volume fails every queued parse with "Stored file is missing".
UPLOAD_DIR=/var/lib/gstbot/invoices
# Caddy's request_body limit must stay above this, or an oversized upload is
# rejected at the edge with a bare 413 the UI cannot explain.
MAX_UPLOAD_MB=15

# ---- Email (filing-deadline alert digests) ----
# Off: this box has no SMTP relay configured. Alerts stay visible in-app
# either way — see app/services/alert_delivery.py for what turning this on
# adds. To enable, set ALERTS_EMAIL_ENABLED=true and fill in SMTP_HOST plus
# credentials for whichever relay sends this deployment's mail.
ALERTS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=alerts@gst.doaide.com

# ---- Site administrators ----
# Comma-separated sign-in emails that may read the feedback inbox and the
# browser error log at /admin/feedback. Empty means nobody can: every
# registered user owns a business, so "signed in" is not enough.
ADMIN_EMAILS=

# ---- AI (Gemini — the GST advisor chatbot) ----
# Empty: the advisor answers 503 "not set up yet" rather than failing per
# question. The key may instead live in /opt/GSTBot/keys/gemini-api-key
# (readable by gstbot); this variable wins when both are set.
GEMINI_API_KEY=
# GEMINI_API_KEY_FILE=/opt/GSTBot/keys/gemini-api-key

# ---- AI (TypeSafe Jev — advisory invoice classification) ----
# Empty: Jev is never called. Its answers are stored beside an extraction for
# a reviewer and never overwrite a parsed figure.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# JEV_TIMEOUT_SECONDS=5
# JEV_FAILURE_COOLDOWN_SECONDS=60

# ---- Payments (Razorpay) ----
# Empty: /pricing shows the plans and checkout answers 503. The key id is the
# only one the browser ever sees (Checkout needs it); the secret and the
# webhook secret stay here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Invoices per calendar month by plan, 0 = unlimited. A paid subscription
# applies pro (Pro) or ca_bundle (CA); a lapsed one falls back to the
# business's stored plan.
PLAN_MONTHLY_INVOICE_LIMITS=free=50,starter=500,pro=0,ca_bundle=0

# ---- Sign-in providers (OAuth) ----
# A provider with an empty client id is not offered on the login page.
# Once any client id is set, OAUTH_REDIRECT_BASE must be the https origin
# below or the API refuses to start: its default is a developer's laptop.
# Each provider's console must list this callback:
#   https://gst.doaide.com/api/v1/auth/<google|github|microsoft>/callback
OAUTH_REDIRECT_BASE=https://gst.doaide.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Email subscribers (deadline reminders) ----
# HMAC key for unsubscribe links. Falls back to JWT_SECRET when empty, but a
# dedicated one means rotating JWT_SECRET does not break every unsubscribe
# link already in someone's inbox. Generate like JWT_SECRET.
SUBSCRIBER_HMAC_SECRET=

# ---- WhatsApp bot ----
# Twilio auth token for X-Twilio-Signature; empty disables the check, which
# is only right for development. The verify token answers the Cloud API's
# GET handshake. The base URL is the public origin Twilio signed, needed
# because behind Caddy the request URL the app sees is not that one.
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_BASE_URL=https://gst.doaide.com
# The number the /whatsapp page links to is a frontend build variable, not
# one of these: set VITE_WHATSAPP_NUMBER when building the frontend.

# ---- Tunables ----
# Defaults that are right for this box; listed so they can be found. Each is
# bounded in app/core/config.py, which refuses a value outside its range.
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_STATEMENT_TIMEOUT_SECONDS=30
# REDIS_TIMEOUT_SECONDS=2
# CELERY_MAX_TASKS_PER_CHILD=200
# INVOICE_PARSE_STALL_SECONDS=3600
# OPENROUTER_TIMEOUT_SECONDS=90
# OPENROUTER_CALL_BUDGET_SECONDS=80
# SMTP_TIMEOUT_SECONDS=10
# SMTP_MAX_ATTEMPTS=3
# SMTP_RETRY_MAX_WAIT_SECONDS=15

# ---- Monitoring ----
# Read by deploy/monitor.sh, not by the application. Optional: unset, the
# 15-minute health check still runs and still leaves a failed unit behind it,
# which `systemctl is-failed gstbot-monitor` answers. Set, the same report
# reaches somewhere with a person attached. Slack, Discord and Mattermost
# incoming webhook URLs all work as-is. See "Monitoring" in deploy/README.md.
GSTBOT_ALERT_WEBHOOK=

# ---- Process counts ----
# Read by the unit files, not by the application.
#
# 2 API workers, not 4. The box is 4 GB and already runs GoSumo, Documedic,
# Herald and the knol containers; a uvicorn worker with this dependency set
# resident is roughly 120 MB, and the frontend build needs headroom of its own
# at release time. Raise this when the box grows, not when a page feels slow.
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info
