# Copy to .env and fill in. Never commit the filled-in file.

# ---- App ----
ENVIRONMENT=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# bcrypt's cost exponent. Each step doubles what a login and an offline
# cracker both pay. Production refuses to boot below 10; the test suite
# runs at 4 so it is not mostly key stretching.
BCRYPT_ROUNDS=12

# ---- Database ----
DATABASE_URL=postgresql+psycopg://gstbot:gstbot@localhost:5432/gstbot

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
# How long a discovered Redis outage is believed before it is probed again.
# The whole cost of an outage is one connect attempt per interval per process.
REDIS_RETRY_INTERVAL_SECONDS=30
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# false runs invoice parsing inline in the request instead of on a worker.
CELERY_ENABLED=true

# ---- AI (TypeSafe Jev — advisory invoice/HSN classification) ----
# Blank = Jev is never called. Local key file: /Users/dev/projects/keys/typesafe_api_key.txt
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ---- AI (OpenRouter, free models only) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_APP_URL=https://gst.doaide.com
OPENROUTER_APP_TITLE=DoAide GST
# Free models rate-limit as a matter of course, and a 429 the client does not
# retry is an invoice parsed by regex instead. Transient failures only (429,
# 408, 5xx, network); a 401 still fails on the first attempt.
OPENROUTER_MAX_ATTEMPTS=3
# Ceiling on total time spent waiting between those attempts, honouring the
# provider's Retry-After. Matters most with CELERY_ENABLED=false, where
# extraction runs inline and this is latency in the upload request.
OPENROUTER_RETRY_MAX_WAIT_SECONDS=30

# ---- Razorpay (subscription payments) ----
# Test mode keys from the Razorpay dashboard; leave empty to disable payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp Bot ----
# Twilio auth token for verifying webhook signatures. Leave empty to skip
# signature checking (development / non-Twilio providers).
WHATSAPP_TWILIO_AUTH_TOKEN=
# WhatsApp Cloud API verification token for the GET handshake.
WHATSAPP_VERIFY_TOKEN=
# Public base URL for Twilio signature verification behind a reverse proxy.
# Example: https://gst.doaide.com/api/v1
WHATSAPP_WEBHOOK_BASE_URL=

# ---- Uploads ----
UPLOAD_DIR=./data/invoices
MAX_UPLOAD_MB=15

# ---- Email (filing-deadline alert digests) ----
# Off by default; alerts still show in-app with nothing set below.
ALERTS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=alerts@gst.doaide.com
# A digest that fails waits for tomorrow's run, which is not a good enough
# answer for an alert about a return due tomorrow. Transient refusals only —
# SMTP's 4xx, a dropped connection, a relay not listening yet. A 5xx names a
# mailbox that does not exist and is final on the first attempt.
SMTP_MAX_ATTEMPTS=3
# Ceiling on total time spent waiting between those attempts, per message.
# Paid once per recipient across every tenant in the run, so a relay that is
# genuinely down ends the digest task in minutes rather than holding a worker.
SMTP_RETRY_MAX_WAIT_SECONDS=15

# ---- Optional integrations ----
# Each is off when empty; fill in only what you are working on. The complete
# list of settings, with what each does, is deploy/gstbot.env.example.
# Emails allowed to read /admin/feedback.
# ADMIN_EMAILS=you@example.com
# The GST advisor chatbot.
# GEMINI_API_KEY=
# Unsubscribe-link signing; falls back to JWT_SECRET.
# SUBSCRIBER_HMAC_SECRET=
# Social sign-in. Register http://localhost:8000/api/v1/auth/<provider>/callback
# with each provider and point the base at the API.
# OAUTH_REDIRECT_BASE=http://localhost:8000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
